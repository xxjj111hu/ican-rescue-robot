<?xml version="1.0"?>
<package format="3">
  <name>ican_nav_tasks</name>
  <version>0.1.0</version>
  <description>iCAN 陆地清障任务 - 导航模块：顺序导航(1-4)、返航停车、限速监控、定位评估</description>
  <maintainer email="team@ican.local">iCAN Rescue Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- 裁判通信模块（E-01）：话题/载荷的单一事实来源 -->
  <exec_depend>ican_referee</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ican_example_navigation</exec_depend>
  <exec_depend>ican_shoot_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
